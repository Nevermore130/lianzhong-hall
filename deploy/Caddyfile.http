# HTTP-only configuration for IP-based access (interim deployment)
# Replace YOUR_IP_HERE with your server's public IP address
# WARNING: WebSocket requires Secure cookies disabled (APP_ORIGIN must be http://)

:80 {
	# Replace with your actual IP
	# bind YOUR_IP_HERE

	# Serve static assets directly from dist with aggressive caching
	# These are versioned/hashed, so immutable caching is safe
	handle /assets/* {
		root * /opt/lianzhong-hall/dist
		file_server
		encode gzip zstd
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# Serve other static files (favicon, textures) with shorter cache
	handle /favicon.svg {
		root * /opt/lianzhong-hall/dist
		file_server
		encode gzip zstd
		header Cache-Control "public, max-age=86400"
	}

	handle /textures/* {
		root * /opt/lianzhong-hall/dist
		file_server
		encode gzip zstd
		header Cache-Control "public, max-age=86400"
	}

	# WebSocket endpoint - must go to Node
	@websocket {
		path /ws
	}
	reverse_proxy @websocket 127.0.0.1:3088 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# API routes - must go to Node
	handle /api/* {
		reverse_proxy 127.0.0.1:3088 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Everything else (index.html, SPA fallback) goes to Node
	handle {
		reverse_proxy 127.0.0.1:3088 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Logging
	log {
		output file /var/log/caddy/lianzhong-access.log
	}

	# Security headers (except HSTS since we're on HTTP)
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		-Server
	}
}
