# HTTPS configuration with automatic TLS from Let's Encrypt
# Replace yourdomain.com with your actual domain
# Ensure DNS A/AAAA records point to your server IP before starting

yourdomain.com {
	# Automatic HTTPS via Let's Encrypt
	# Caddy will request and renew certificates automatically

	# Serve static assets directly from dist with aggressive caching
	# These are versioned/hashed, so immutable caching is safe
	handle /assets/* {
		root * /opt/lianzhong-hall/dist
		file_server
		encode gzip zstd
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# Serve other static files (favicon, textures) with shorter cache
	handle /favicon.svg {
		root * /opt/lianzhong-hall/dist
		file_server
		encode gzip zstd
		header Cache-Control "public, max-age=86400"
	}

	handle /textures/* {
		root * /opt/lianzhong-hall/dist
		file_server
		encode gzip zstd
		header Cache-Control "public, max-age=86400"
	}

	# WebSocket endpoint - must go to Node
	@websocket {
		path /ws
	}
	reverse_proxy @websocket 127.0.0.1:3088 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# API routes - must go to Node
	handle /api/* {
		reverse_proxy 127.0.0.1:3088 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Everything else (index.html, SPA fallback) goes to Node
	handle {
		reverse_proxy 127.0.0.1:3088 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Logging
	log {
		output file /var/log/caddy/lianzhong-access.log
	}

	# Security headers
	header {
		# HSTS - tell browsers to always use HTTPS
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		-Server
	}
}

# Optional: redirect www to non-www
# www.yourdomain.com {
# 	redir https://yourdomain.com{uri} permanent
# }
