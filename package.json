{
  "name": "lianzhong-hall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1 --port 5188 --strictPort\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test --test-timeout=15000 tests/*.test.ts",
    "format": "prettier --write src server shared tests docs *.ts *.json *.md",
    "format:check": "prettier --check src server shared tests docs *.ts *.json *.md"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.0.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
