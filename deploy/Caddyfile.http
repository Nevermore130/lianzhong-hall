# HTTP-only configuration for temporary IP-based access
# Use this ONLY for initial testing before DNS/certificates are ready
#
# WARNING: This is NOT for production use
# - No encryption means credentials and game data are sent in plaintext
# - WebSocket requires APP_ORIGIN=http://YOUR.SERVER.IP in .env
# - Switch to Caddyfile.https as soon as DNS is pointing to your server
#
# Deployment path: /var/www/lianzhong-hall (to match production)
# If you used a different path during install, adjust the root directive below

:80 {
	encode gzip zstd

	handle /assets/* {
		root * /var/www/lianzhong-hall/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /favicon.svg {
		root * /var/www/lianzhong-hall/dist
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3088
	}
}
