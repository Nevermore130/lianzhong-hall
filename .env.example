# Copy to .env. The server loads it automatically; existing environment variables take precedence.
HOST=127.0.0.1
PORT=3088
DATABASE_PATH=data/hall.sqlite
# npm run dev uses 5188. For npm start, use http://127.0.0.1:3088.
APP_ORIGIN=http://127.0.0.1:5188

# Local acceptance: no emails are sent externally. Inbox listens on loopback only.
MAIL_MODE=local
MAIL_INBOX_PORT=3089

# Production: use NODE_ENV=production, MAIL_MODE=smtp and an HTTPS APP_ORIGIN.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=Game Hall <noreply@example.com>
# SMTP_USER=
# SMTP_PASSWORD=
# Port 465 uses TLS directly; other ports require STARTTLS.
