# Production HTTPS configuration with automatic TLS from Let's Encrypt
# This matches the production setup for zhongle.online
#
# Prerequisites:
# - DNS A/AAAA records for your domain(s) must point to your server IP
# - Caddy must be able to reach ports 80/443 for ACME HTTP-01 challenge
# - Email address for Let's Encrypt renewal notices
#
# Deployment path: /var/www/lianzhong-hall (matches production)
# If you used a different path during install, adjust the root directive below

{
	email admin@zhongle.online
}

(app) {
	encode gzip zstd

	handle /assets/* {
		root * /var/www/lianzhong-hall/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /favicon.svg {
		root * /var/www/lianzhong-hall/dist
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3088
	}
}

zhongle.online, www.zhongle.online {
	import app
}
