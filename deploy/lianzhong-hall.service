[Unit]
Description=Lianzhong Game Hall
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/lianzhong-hall

# Load environment from .env file if present (optional)
EnvironmentFile=-/opt/lianzhong-hall/.env

# Critical environment variables with fallback defaults
Environment="NODE_ENV=production"
Environment="PORT=3088"
Environment="HOST=127.0.0.1"
Environment="DATABASE_PATH=data/hall.sqlite"
Environment="APP_ORIGIN=http://YOUR_IP_OR_DOMAIN_HERE"
Environment="MAIL_MODE=disabled"

# For HTTPS with domain, set APP_ORIGIN=https://yourdomain.com in .env
# For SMTP email, set MAIL_MODE=smtp and configure SMTP_* in .env
# SMTP_HOST, SMTP_PORT, SMTP_FROM, SMTP_USER, SMTP_PASSWORD

ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lianzhong-hall

[Install]
WantedBy=multi-user.target
